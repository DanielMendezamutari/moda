# Build: npm run build:hosting  (o pnpm) → compilacion-para-hosting/
# Publicar: cd ../backend && php artisan panel:publish
#
# IMPORTANTE: VITE_APP_BASE debe ser EXACTAMENTE lo que va después del dominio
# hasta /panel/ (mirá la barra del navegador cuando abrís el POS).
#
# --- Elegí UN solo bloque (dejá activas solo 2 líneas VITE_...) ---

# Opción 1 — Document root = backend/public del subdominio (URL limpia)
# Ejemplo: https://moda.ribersoft.com/panel/  y  https://moda.ribersoft.com/api
VITE_APP_BASE=/panel/
VITE_API_BASE_URL=https://moda.ribersoft.com/api

# Opción 2 — Laravel bajo ruta /backend/public/ (cPanel sin cambiar document root)
# VITE_APP_BASE=/backend/public/panel/
# VITE_API_BASE_URL=https://moda.ribersoft.com/backend/public/api

# Opción 3 — Con carpeta extra /moda/...
# VITE_APP_BASE=/moda/backend/public/panel/
# VITE_API_BASE_URL=https://moda.ribersoft.com/moda/backend/public/api
