# Build: npm run build:hosting  (o pnpm) → carpeta compilacion-para-hosting/
# Publicar en Laravel: cd ../backend && php artisan panel:publish
#
# --- Rutas en el NAVEGADOR (ajustá VITE_APP_BASE a lo que veas después del dominio) ---
#
# A) Recomendado: el dominio apunta solo a backend/public
#    Ejemplo: https://tudominio.com/panel/
# VITE_APP_BASE=/panel/
# VITE_API_BASE_URL=https://tudominio.com/api
#
# B) Laravel bajo subcarpetas (tu caso típico en cPanel):
#    Ejemplo panel: https://moda.ribersoft.com/moda/backend/public/panel/
#    Ejemplo API:  https://moda.ribersoft.com/moda/backend/public/api
VITE_APP_BASE=/moda/backend/public/panel/
VITE_API_BASE_URL=https://moda.ribersoft.com/moda/backend/public/api
